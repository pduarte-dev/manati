# Configuração do Manati Editor - Arquivo de Exemplo
# Copie este arquivo para .env e ajuste as configurações conforme necessário

# Porta do servidor
PORT=3000

# Diretório raiz para arquivos markdown
# Exemplos:
# Para pasta relativa ao projeto:
MARKDOWN_ROOT_DIR=./markdown-files

# Para pasta absoluta:
# MARKDOWN_ROOT_DIR=/home/usuario/documentos/markdown

# Para pasta em outro local:
# MARKDOWN_ROOT_DIR=../content/markdown

# Diretório para uploads
UPLOADS_DIR=./uploads

# Habilitar logs de debug no backend (true/false)
# Para desenvolvimento, defina como true para ver logs detalhados
LOG_DEBUG=false

# Autenticação GitHub OAuth
# Para obter estas credenciais:
# 1. Acesse https://github.com/settings/applications/new
# 2. Application name: Manati Editor
# 3. Homepage URL: http://localhost:3000
# 4. Authorization callback URL: http://localhost:3000/auth/github/callback
AUTH_ENABLED=true
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Domínio de email autorizado (incluir o @)
ALLOWED_EMAIL_DOMAIN=@waproject.com.br

# Segurança
SESSION_SECRET=your-secure-session-secret-change-this-in-production
